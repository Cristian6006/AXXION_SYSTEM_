<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Selector de Productos -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilProducto"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Seleccionar Producto *"
        app:boxStrokeColor="@color/axxion_primary"
        app:hintTextColor="@color/axxion_primary"
        app:endIconMode="dropdown_menu">

        <AutoCompleteTextView
            android:id="@+id/inputProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:completionThreshold="0" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ID del Inventario (Requerido) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilInventarioId"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ID del Inventario *"
        app:boxStrokeColor="@color/axxion_primary"
        app:hintTextColor="@color/axxion_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etInventarioId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="10" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Descripción del Problema -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDescripcion"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Descripción del Problema"
        app:boxStrokeColor="@color/axxion_primary"
        app:hintTextColor="@color/axxion_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:lines="3"
            android:maxLength="500" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Responsable -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilResponsable"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Responsable"
        app:boxStrokeColor="@color/axxion_primary"
        app:hintTextColor="@color/axxion_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etResponsable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:maxLength="100" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Costo Estimado -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCostoEstimado"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Costo Estimado"
        app:boxStrokeColor="@color/axxion_primary"
        app:hintTextColor="@color/axxion_primary"
        app:prefixText="$">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCostoEstimado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:maxLength="15" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nota sobre campos requeridos -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="* Campo requerido"
        android:textColor="@color/axxion_text_muted"
        android:textSize="12sp" />

</LinearLayout>