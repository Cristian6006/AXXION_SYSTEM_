<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/axxion_background"
            android:fillViewport="true">


    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">


        <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Detalles del Activo"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="32dp"
                app:layout_constraintStart_toEndOf="@id/btnVolverDetail"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0" android:gravity="center"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolverDetail"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/text_primary"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="32dp"/>
        <TextView
                android:id="@+id/lblEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cambiar Estado"
                android:textColor="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView6"
                android:layout_marginTop="16dp"
        />
        <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="228dp"
                app:layout_constraintHorizontal_bias="0.498"/>


        <TextView
                android:id="@+id/tvMarcaModelo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                app:layout_constraintStart_toEndOf="@id/textView4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/textView4"
                app:layout_constraintBottom_toBottomOf="@id/textView4"/>
        <Spinner
                android:id="@+id/spinnerEstado"
                android:layout_width="106dp"
                android:layout_height="32dp"
                android:background="@color/axxion_background"
                android:backgroundTint="@color/axxion_secondary"
                app:layout_constraintTop_toBottomOf="@id/lblEstado"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"/>
        <EditText
                android:id="@+id/etNotas"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_axxion_input"
                android:gravity="top"
                android:hint="Notas internas de reparación o mantenimiento..."
                android:padding="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/axxion_text_muted"
                app:layout_constraintTop_toBottomOf="@id/spinnerEstado"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/btnActualizar"/>

        <Button
                android:id="@+id/btnActualizar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="GUARDAR CAMBIOS"
                android:backgroundTint="@color/axxion_primary"
                android:textColor="@color/white"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@id/etNotas"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
                android:text="Nombre:  "
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/axxion_background"
                android:backgroundTint="@color/axxion_background" android:textColor="@color/text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView10"
                android:layout_marginTop="16dp"/>
        <TextView
                android:id="@+id/tvNombre"
                android:text=""
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/textView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/textView"
                app:layout_constraintBottom_toBottomOf="@id/textView"
                app:layout_constraintHorizontal_bias="0.0" android:textColor="@color/text_primary"/>
        <TextView
                android:text="Numero de Serie:  "
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/textView3"
                android:textColor="@color/text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView"
                android:layout_marginTop="12dp"/>
        <TextView
                android:text="Marca:  "
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/textView4"
                android:textColor="@color/text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView3"
                android:layout_marginTop="12dp"/>
        <TextView
                android:text="Modelo:  "
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/textView5"
                android:textColor="@color/text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView4"
                android:layout_marginTop="12dp"/>
        <TextView
                android:text="Valor Actual:  "
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/textView6"
                android:textColor="@color/text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView5"
                android:layout_marginTop="12dp"/>
        <TextView
                android:text=""
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/tvNumeroSerie"
                app:layout_constraintStart_toEndOf="@id/textView3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/textView3"
                app:layout_constraintBottom_toBottomOf="@id/textView3" android:textColor="@color/text_primary"/>
        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/tvModelo"
                app:layout_constraintStart_toEndOf="@id/textView5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/textView5"
                app:layout_constraintBottom_toBottomOf="@id/textView5" android:textColor="@color/text_primary"/>
        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/tvValor"
                app:layout_constraintStart_toEndOf="@id/textView6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/textView6"
                app:layout_constraintBottom_toBottomOf="@id/textView6" android:textColor="@color/text_primary"/>
        <TextView
                android:text="Especificaciones esenciales"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/textView10"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                android:textColor="@color/text_secondary" android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_bias="0.579"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
