<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AxxionSystem" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_600</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnSecondary">@color/bg_dark_navy</item>
        <item name="android:windowBackground">@color/bg_dark_navy</item>
        <item name="android:statusBarColor">@color/bg_dark_navy</item>
        <item name="android:navigationBarColor">@color/bg_dark_navy</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_white</item>
    </style>

    <!-- Estilo de diálogo oscuro -->
    <style name="Theme.AxxionSystem.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@color/bg_dark_navy</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DialogTitleStyle</item>
    </style>

    <style name="DialogTitleStyle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">#E8EAF6</item>
    </style>
</resources>