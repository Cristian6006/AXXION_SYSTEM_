<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0D1B2A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header con icono -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_add"
                android:background="@drawable/bg_badge"
                android:padding="12dp"
                app:tint="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Nueva Solicitud"
                android:textColor="#E8EAF6"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Campo: Cliente ID -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID de Cliente"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#4FC3F7"
            app:hintTextColor="#4FC3F7"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputClienteId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="#E8EAF6"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo: Cantidad -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Cantidad de máquinas"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#4FC3F7"
            app:hintTextColor="#4FC3F7"
            app:startIconDrawable="@android:drawable/ic_menu_agenda"
            app:startIconTint="#4FC3F7"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCantidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1"
                android:textColor="#E8EAF6"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo: Descripción -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Describe tu necesidad"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#4FC3F7"
            app:hintTextColor="#4FC3F7"
            app:startIconDrawable="@android:drawable/ic_menu_edit"
            app:startIconTint="#4FC3F7"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top"
                android:textColor="#E8EAF6"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo: Producto Alternativo -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Producto alternativo (opcional)"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#78909C"
            app:hintTextColor="#78909C"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="#78909C"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputProductoAlt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="#E8EAF6"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Info text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="💡 Tu solicitud será revisada por nuestro equipo. Te contactaremos para confirmar la disponibilidad."
            android:textColor="#78909C"
            android:textSize="12sp"/>

    </LinearLayout>

</ScrollView>
