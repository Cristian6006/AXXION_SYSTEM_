            tools:visibility="visible" android:textSize="20sp"/>
    <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:ems="10"
            android:id="@+id/editTextTextPassword2" tools:layout_editor_absoluteY="458dp"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.502" android:hint="PASSWORD" android:backgroundTint="#3F51B5"
            android:visibility="visible" tools:visibility="visible" android:textSize="20sp"/>
