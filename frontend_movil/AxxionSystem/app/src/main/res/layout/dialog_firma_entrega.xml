<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0D1B2A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_upload"
                android:background="@drawable/bg_badge"
                android:padding="12dp"
                app:tint="#FFFFFF"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Firmar Entrega"
                    android:textColor="#E8EAF6"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvRentaId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Renta #000"
                    android:textColor="#4FC3F7"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Campo: ID Dirección -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID de Dirección"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#4FC3F7"
            app:hintTextColor="#4FC3F7"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDireccionId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1"
                android:textColor="#E8EAF6"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo: Firma Digital -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Firma Digital (texto o Base64)"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#4FC3F7"
            app:hintTextColor="#4FC3F7"
            app:startIconDrawable="@android:drawable/ic_lock_lock"
            app:startIconTint="#4FC3F7"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputFirma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:gravity="top"
                android:textColor="#E8EAF6"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo: Notas -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Notas de entrega"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#78909C"
            app:hintTextColor="#78909C"
            app:startIconDrawable="@android:drawable/ic_menu_edit"
            app:startIconTint="#78909C"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:gravity="top"
                android:textColor="#E8EAF6"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="⚠️ La firma digital confirma la recepción de la maquinaria en obra."
            android:textColor="#FF9800"
            android:textSize="12sp"/>

    </LinearLayout>

</ScrollView>
