<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#1A3A5C"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: ID y Estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Badge de tipo (Solicitud/Renta) -->
            <TextView
                android:id="@+id/tvTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                tools:text="SOLICITUD"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- Badge de estado -->
            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_estado"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="PENDIENTE"/>

        </LinearLayout>

        <!-- ID Principal -->
        <TextView
            android:id="@+id/tvId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#4FC3F7"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Solicitud #123"/>

        <!-- Línea divisora -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#2A4A6C"/>

        <!-- Información Principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Para Solicitudes: Cliente y Cantidad -->
            <LinearLayout
                android:id="@+id/layoutSolicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cliente ID"
                        android:textColor="#78909C"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvClienteId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#E8EAF6"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="#001"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cantidad"
                        android:textColor="#78909C"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvCantidad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#E8EAF6"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="2 unidades"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Para Rentas: Fechas -->
            <LinearLayout
                android:id="@+id/layoutRenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 Inicio"
                        android:textColor="#78909C"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvFechaInicio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#E8EAF6"
                        android:textSize="13sp"
                        tools:text="2024-01-15"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏰ Fin Previsto"
                        android:textColor="#78909C"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvFechaFin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#E8EAF6"
                        android:textSize="13sp"
                        tools:text="2024-01-25"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Descripción / Notas -->
        <LinearLayout
            android:id="@+id/layoutDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textColor="#78909C"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#B0BEC5"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Se necesita maquinaria para construcción de sótano"/>
        </LinearLayout>

        <!-- Items count (para rentas) -->
        <LinearLayout
            android:id="@+id/layoutItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#4FC3F7"/>

            <TextView
                android:id="@+id/tvItemsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#4FC3F7"
                android:textSize="13sp"
                tools:text="3 items en rental"/>
        </LinearLayout>

        <!-- Acciones (solo visible cuando hay opciones) -->
        <LinearLayout
            android:id="@+id/layoutAcciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccion"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Ver Opciones"
                android:textSize="12sp"
                app:backgroundTint="#1565C0"
                app:cornerRadius="8dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
