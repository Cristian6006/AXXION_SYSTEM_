<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
		xmlns:android="http://schemas.android.com/apk/res/android"
		xmlns:app="http://schemas.android.com/apk/res-auto"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/axxion_background"
		android:padding="24dp">
	
	
	<com.google.android.material.appbar.MaterialToolbar
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="@color/axxion_card"
			app:title="Axxion System"
			app:titleTextColor="@color/white"
			app:layout_constraintTop_toTopOf="parent"/>
	
	
	<TextView
			android:id="@+id/tvWelcome"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="32dp"
			android:text="Cargando perfil..."
			android:textColor="@color/white"
			android:textSize="22sp"
			android:textStyle="bold"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/toolbar"/>
	
	
	<com.google.android.material.chip.Chip
			android:id="@+id/chipRole"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="Rol: Desconocido"
			android:textColor="@color/axxion_background"
			app:chipBackgroundColor="@color/axxion_secondary"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/tvWelcome"/>
	
	
	<com.google.android.material.loadingindicator.LoadingIndicator
			style="@style/Widget.Material3.LoadingIndicator.Contained"
			android:id="@+id/progressBarHome"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:indeterminate="true"
			android:visibility="gone"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toEndOf="parent"/>
	
	<com.google.android.material.button.MaterialButton
			android:id="@+id/btnLogout"
			style="@style/Widget.Material3.Button.OutlinedButton"
			android:layout_width="match_parent"
			android:layout_height="56dp"
			android:layout_marginBottom="24dp"
			android:text="CERRAR SESIÓN"
			android:textColor="@color/axxion_secondary"
			app:cornerRadius="12dp"
			app:layout_constraintBottom_toBottomOf="parent"
			app:strokeColor="@color/axxion_secondary"/>

</androidx.constraintlayout.widget.ConstraintLayout>